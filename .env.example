# Database
# Local dev:
# DATABASE_URL=postgresql://leadbox:leadbox_password@localhost:5432/leadbox
# DIRECT_URL=postgresql://leadbox:leadbox_password@localhost:5432/leadbox
# Production (Supabase - IPv6, works on Vercel):
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Auth
AUTH_SECRET=generate-a-random-32-byte-hex-string
AUTH_URL=http://localhost:3000

# Encryption key for API keys at rest (32-byte hex)
ENCRYPTION_KEY=generate-a-random-64-char-hex-string

# Supabase (for password-reset emails via Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (optional - can also be set per-workspace)
OPENAI_API_KEY=sk-...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron (auto-populated on Vercel, set manually for local testing)
CRON_SECRET=generate-a-random-string

# Transactional email via Resend (optional - without it, emails are only logged)
RESEND_API_KEY=
EMAIL_FROM="LeadBox <onboarding@resend.dev>"

# Anthropic (optional - used for AI labeling / bounce reports; can also be set per-workspace)
ANTHROPIC_API_KEY=

# Optional overrides for enrichment providers
# APOLLO_API_BASE=https://api.apollo.io/api/v1
# BLITZ_API_BASE=https://api.blitz-api.ai
